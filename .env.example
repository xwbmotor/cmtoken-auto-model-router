# ============================================================
# Auto Model Router 环境变量模板（v0.4.22+）
# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，绝不提交。
# ============================================================

# —— 上游 MaaS（必填二选一场景）——
# strict 模式（路由器持服务端 key 调上游）必填 MAAS_API_KEY
MAAS_API_KEY=replace-with-rotated-maas-key
MAAS_BASE_URL=https://maas.example.internal/v1

# —— key 模式（v0.4.21+）——
# strict（默认）：客户端持 ROUTER_ACCESS_KEY，路由器用 MAAS_API_KEY 调上游
# passthrough：MaaS 网关分流 model=auto 场景——客户端的 apikey 原样透传上游，
#   同 URL 同 key，计费/配额落调用方租户。此时可不设 MAAS_API_KEY/ROUTER_ACCESS_KEY。
ROUTER_KEY_MODE=strict
ROUTER_ACCESS_KEY=replace-with-long-router-client-key

# —— 管理端 ——
# 登录运营管理后台（/）与调用 /admin/api/* 时使用。生产必设。
ADMIN_TOKEN=replace-with-long-admin-token

# Prometheus 抓取 /metrics 的 token。反代暴露时必设，否则该端点裸奔。
METRICS_TOKEN=replace-with-long-metrics-token

# —— 监听 ——
# 默认只允许本机访问；容器/反代部署时设 0.0.0.0 并靠 ADMIN_TOKEN+反代 ACL 保护。
HOST=127.0.0.1
PORT=8787
CONFIG_PATH=./config/router.json

# —— 分类器（可选）——
# http-json provider 的分类服务地址（compose 部署时默认 http://classifier:8788/classify）
# SEMANTIC_CLASSIFIER_URL=http://classifier:8788/classify

# 语义灰度分桶 HMAC secret（v0.7.2 八审 P1）——semanticRouter.mode=active 时必填。
# 缺失时每次容器重启实验组重洗，破坏灰度对照；shadow 模式可省（进程级随机 secret）。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SEMANTIC_BUCKET_SECRET=<openssl rand -base64 32 的输出>
# 评测脚本用的 Python 路径（默认自动探测 .venv，Linux 裸机部署时按需覆盖）
# CLASSIFIER_PYTHON=/usr/bin/python3

# —— 超时（可选，默认已合理）——
# HTTP_KEEPALIVE_MS=300000
# HTTP_HEADERS_TIMEOUT_MS=310000

# —— 上游为网关时的改道（可选）——
# UPSTREAM_BASE_URL=http://gateway:4000/v1
# UPSTREAM_API_KEY=replace-with-gateway-key
