# MaaS 上游。请使用已轮换、未在聊天或代码中暴露的新 Key。
MAAS_API_KEY=replace-with-rotated-maas-key
MAAS_BASE_URL=https://maas.gd.chinamobile.com:36007/ai/uifm/open/v1

# 应用调用 Auto Router 时使用，和 MaaS Key 不是同一个 Key。
ROUTER_ACCESS_KEY=replace-with-long-router-client-key

# 登录运营管理后台时使用。
ADMIN_TOKEN=replace-with-long-admin-token

# 仅在启用 LiteLLM 组合部署时使用。
LITELLM_MASTER_KEY=replace-with-long-litellm-master-key

# 默认只允许本机访问。
HOST=127.0.0.1
PORT=8787
CONFIG_PATH=./config/router.json

# 如果 Auto Router 的上游改成 LiteLLM，取消下面两行注释。
# UPSTREAM_BASE_URL=http://litellm:4000/v1
# UPSTREAM_API_KEY=replace-with-litellm-master-key
