# Auto Model Router 本地开发环境模板
# 本文件用于直接运行 Node 服务。完整安装使用 deployment/offline/README.md，
# 安装脚本会独立生成凭证和 Compose，不需要复制此模板。
# 如需本地运行，复制为 .env，填写实际值；.env 不提交到仓库。

# 上游 MaaS 地址与服务端 key。下面演示 strict 模式。
MAAS_API_KEY=replace-with-rotated-maas-key
MAAS_BASE_URL=https://maas.example.internal/v1

# strict：客户端使用 ROUTER_ACCESS_KEY，由服务端 key 调用上游。
# passthrough：使用调用方的 MaaS key。正式 Shell 安装采用此模式。
ROUTER_KEY_MODE=strict
ROUTER_ACCESS_KEY=replace-with-long-router-client-key

# 管理页面和管理 API 的登录凭证。
ADMIN_TOKEN=replace-with-long-admin-token

# Prometheus 抓取 /metrics 的凭证。
METRICS_TOKEN=replace-with-long-metrics-token

# 本地监听与配置路径。
HOST=127.0.0.1
PORT=8787
CONFIG_PATH=./config/router.json

# 可选：分类器地址。
# SEMANTIC_CLASSIFIER_URL=http://127.0.0.1:8788/classify

# 语义灰度分桶密钥，跨重启应保持稳定。active 模式要求有效密钥。
# 生成示例：openssl rand -base64 32
# SEMANTIC_BUCKET_SECRET=<随机生成的密钥>

# 可选：本地评测使用的 Python。
# CLASSIFIER_PYTHON=/usr/bin/python3

# 可选：HTTP 连接超时，单位为毫秒。
# HTTP_KEEPALIVE_MS=300000
# HTTP_HEADERS_TIMEOUT_MS=310000

# 可选：覆盖上游地址和凭证。
# UPSTREAM_BASE_URL=http://gateway:4000/v1
# UPSTREAM_API_KEY=replace-with-gateway-key
