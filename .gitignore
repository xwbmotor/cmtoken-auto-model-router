.env
.env - 副本.example
.env.local
state/
benchmark-results/
data/*
!data/training/
data/training/*.log
data/training/raw-v2-mislabeled.jsonl
node_modules/
.venv/
__pycache__/
*.pyc
*.log

# 运行时配置备份（含内网端点，不入库不外发）
config/history/

# 内部一次性任务稿（面向开源分发不适用，本地留档不入库）
docs/给openclaw的部署交代.md

# 发布报告作 Release Artifact 归档，不提交回被证明的 tag（避免报告改变被验证的源码提交）
reports/release-*.json

# 管理端浏览器验收产物留作本地证据，不污染发布提交
reports/workspace-ux/

# Temporary local debug directories
amr-dbg-*/
