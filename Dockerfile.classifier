# 语义分类器：自训练小模型（TF-IDF + LogReg/Ridge），独立于主路由进程
# 依赖 sklearn/joblib/numpy，单独成层避免污染零依赖的 Node 主镜像
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# sklearn/joblib/numpy/scipy：v0.10.5 起按 requirements-classifier.lock 精确锁定安装
# （十九审：Dockerfile 此前未用锁文件，重建会重新解析版本、ABI 组合不可复现）
COPY --chown=nobody:nogroup requirements-classifier.lock ./requirements-classifier.lock
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    -r requirements-classifier.lock

COPY --chown=nobody:nogroup scripts/classifier_common.py scripts/serve_classifier.py ./scripts/
COPY --chown=nobody:nogroup data/training/model/ ./data/training/model/

# COPY 的父目录仍可能归 root；预建启动日志，允许运行用户写入。
RUN touch /app/data/training/serve.log && chown nobody:nogroup /app/data/training/serve.log

# v0.10.4：OCI revision 标签（发布门禁证据链要求；构建时 --build-arg GIT_REVISION=<commit>）
ARG GIT_REVISION=unlabeled
LABEL org.opencontainers.image.revision="${GIT_REVISION}"

USER nobody

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request,sys;sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8788/health',timeout=3).status==200 else 1)"

EXPOSE 8788

CMD ["python", "scripts/serve_classifier.py", "--host", "0.0.0.0", "--port", "8788"]
