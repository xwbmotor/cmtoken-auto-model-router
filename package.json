{
  "name": "cmt-auto-model-router",
  "version": "0.11.12",
  "private": true,
  "type": "module",
  "description": "OpenAI-compatible, self-hosted-first model auto router for China Mobile MaaS",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/server.mjs",
    "test": "node --test --test-concurrency=1",
    "test:release": "node scripts/run-release-tests.mjs",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark.mjs",
    "benchmark:stream": "node --env-file-if-exists=.env scripts/stream-performance.mjs",
    "eval:gate": "node --env-file-if-exists=.env scripts/eval-gate.mjs",
    "eval:subtask": "node --env-file-if-exists=.env scripts/subtask-eval.mjs",
    "eval:regen": "node --env-file-if-exists=.env scripts/subtask-regen.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}